      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(autocheck_judge_queue_poll_success{service=\"worker\"})",
          "legendFormat": "poll success",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "time() - max(autocheck_judge_queue_updated_timestamp_seconds{service=\"worker\"})",
          "legendFormat": "snapshot age (seconds)",
          "datasource": {

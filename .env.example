# Скопируйте в .env и заполните. Ключи тестового магазина: https://yookassa.ru/my → «Тестовый магазин».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Локальный monitoring-профиль. Пароль применяется при первом старте Grafana.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
LOKI_PORT=3100

# Ключ OpenRouter для ИИ-функций: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

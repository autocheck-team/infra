{
  // Демо-стенд в GitHub Codespaces: вся система поднимается внутри машины с Docker.
  // Бесплатная квота личного аккаунта — 120 ядро-часов в месяц, то есть 60 часов на 2 ядрах.
  "name": "Autocheck",
  // Версия Ubuntu закреплена: на более новой фича docker-in-docker не ставится (нет пакетов Moby).
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // SSH нужен для `gh codespace ssh` и `gh codespace logs`: без него стенд не продиагностировать.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postStartCommand": "docker compose pull --ignore-pull-failures && docker compose up -d",
  "forwardPorts": [8080, 8180, 8333],
  "portsAttributes": {
    "8080": { "label": "API" },
    "8180": { "label": "Keycloak" },
    "8333": { "label": "S3" }
  }
}
